# Copy this file to .env and change the values. Never commit .env to Git.

# Signs login tokens and keys the pseudonymisation. Use a long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VYUH_SECRET_KEY=change-me-to-a-long-random-string

# Key a bank's systems send in the X-API-Key header for /api/v1/score and /api/v1/events
VYUH_API_KEY=change-me-too

# Passwords for the three built-in users (used only when the database is first created)
VYUH_INVESTIGATOR_PASSWORD=Investigator@123
VYUH_SUPERVISOR_PASSWORD=Supervisor@123
VYUH_AUDITOR_PASSWORD=Auditor@123

# Optional tuning
# Host port for Docker (change if 8000 is already used on your PC)
# VYUH_PORT=8001
# VYUH_SIM_CUSTOMERS=8000
# VYUH_DEFAULT_SPEED=300
# VYUH_ANALYST_CAPACITY=40
# VYUH_CASE_MIN_CONFIDENCE=0.70
# VYUH_SLOW_PATH_EVERY_MIN=2          # campaign linking every 2 simulated minutes (Round 1 design)
# VYUH_MODE=full                      # rollout mode: shadow | analyst | warnings | full
# VYUH_THRESHOLD_JITTER=0.02          # +/- jitter on warning/pause thresholds
# VYUH_EVAL_LINK_EVERY_MIN=15         # evaluation runs linking every 15 min (faster, slightly conservative)
